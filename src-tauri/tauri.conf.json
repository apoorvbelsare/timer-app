{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timer",
  "version": "0.1.0",
  "identifier": "com.apoorvbelsare.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "url": "widget.html",
        "title": "Timer",
        "width": 320,
        "height": 128,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "planner",
        "url": "planner.html",
        "title": "Timer · Planner",
        "width": 1040,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Time to switch",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
